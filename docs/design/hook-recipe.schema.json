{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:app-hook-studio:design:hook-recipe:v1",
  "title": "App Hook Studio recipe design example (not a supported import format)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "design-example"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "bundleId": {
          "type": "string",
          "minLength": 1
        },
        "suggestedPath": {
          "type": "string",
          "pattern": "^/.*\\.app$"
        }
      },
      "required": ["id", "bundleId", "suggestedPath"]
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "export": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        }
      },
      "required": ["file", "sha256", "export"]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "defaultTrigger": {
            "$ref": "#/$defs/trigger"
          }
        },
        "required": ["id", "title", "action", "defaultTrigger"]
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "runtimeStatus": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["basis", "runtimeStatus", "notes"]
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "id",
    "title",
    "application",
    "profiles",
    "features",
    "verification"
  ],
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "modifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["ctrl", "meta", "alt", "shift"]
          }
        }
      },
      "required": ["code", "modifiers"]
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "key-sequence"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "withinMs": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "enum": ["panel", "input"]
        },
        "phase": {
          "const": "bubble"
        },
        "consume": {
          "const": "on-match"
        },
        "repeat": {
          "const": "ignore"
        }
      },
      "required": ["kind", "steps", "withinMs", "scope", "phase", "consume", "repeat"]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "before-exact-anchor"
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "expectedMatches": {
          "const": 1
        },
        "enclosingFunction": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        }
      },
      "required": ["kind", "anchor", "expectedMatches", "enclosingFunction"]
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "installer": {
          "const": "text-resource/v1"
        },
        "driver": {
          "const": "react-component/v1"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "bindings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          }
        }
      },
      "required": ["id", "installer", "driver", "placement", "bindings"]
    },
    "invoke": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "call-binding"
            },
            "binding": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "binding"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bridge-method"
            },
            "method": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
            }
          },
          "required": ["kind", "method"]
        }
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "mount": {
          "type": "string",
          "minLength": 1
        },
        "invoke": {
          "$ref": "#/$defs/invoke"
        },
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "binding": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "required": ["binding", "equals"]
        }
      },
      "required": ["action", "mount", "invoke"]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "versionAssertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              },
              "pointer": {
                "type": "string",
                "pattern": "^/"
              },
              "equals": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            "required": ["file", "pointer", "equals"]
          }
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            },
            "encoding": {
              "const": "utf-8"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["path", "encoding", "sha256"]
        },
        "mounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mount"
          }
        },
        "implementations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/implementation"
          }
        }
      },
      "required": ["id", "versionAssertions", "resource", "mounts", "implementations"]
    }
  }
}
