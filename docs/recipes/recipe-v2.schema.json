{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "appPath": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "appVersion": {
          "type": "string",
          "minLength": 1
        },
        "assertions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "pointer": {
                "type": "string",
                "pattern": "^\\/"
              },
              "equals": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["file", "pointer", "equals"],
            "additionalProperties": false
          }
        },
        "resource": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["path", "sha256"],
          "additionalProperties": false
        },
        "mount": {
          "type": "object",
          "properties": {
            "driver": {
              "type": "string",
              "const": "dom-keyboard/v1"
            },
            "anchor": {
              "type": "string",
              "minLength": 1
            },
            "placement": {
              "type": "string",
              "enum": ["before", "after"]
            },
            "rootSelector": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["driver", "anchor", "placement", "rootSelector"],
          "additionalProperties": false
        }
      },
      "required": ["id", "appVersion", "assertions", "resource", "mount"],
      "additionalProperties": false
    },
    "features": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "shortcut": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "default": "shortcut",
            "type": "string",
            "enum": ["shortcut", "double-escape"]
          },
          "withinMs": {
            "default": 500,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "description": "JavaScript function body executed only inside target App on matching keyboard event. Variables: event, root. No execution in MCP/Raycast."
          }
        },
        "required": ["id", "title", "description", "enabled", "shortcut", "trigger", "withinMs", "action"],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtimeStatus": {
          "type": "string",
          "enum": ["not-tested", "tested"]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["sources", "runtimeStatus", "notes"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "id", "title", "appPath", "profile", "features", "evidence"],
  "additionalProperties": false
}
