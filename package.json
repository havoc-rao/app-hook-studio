{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "app-hook-studio",
  "title": "App Hook Studio",
  "description": "Manage version-checked local macOS application hooks, settings and reversible resource patches.",
  "icon": "icon.png",
  "author": "havoc",
  "license": "MIT",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "manage-hooks",
      "title": "Manage App Hooks",
      "description": "选择应用、配置本地补丁、查看状态和恢复原文件",
      "mode": "view"
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist -o dist",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "cli": "tsx scripts/cli.ts",
    "format": "prettier --write src scripts tests docs README.md package.json tsconfig.json",
    "install:local": "ray build -e dist",
    "check:bundle": "node scripts/check-bundle.cjs dist/manage-hooks.js",
    "postbuild": "npm run check:bundle",
    "postinstall:local": "node scripts/check-bundle.cjs --installed",
    "build:mcp": "npm run build:worker && esbuild scripts/mcp.ts --bundle --platform=node --format=cjs --outfile=dist/mcp.cjs",
    "mcp": "tsx scripts/mcp.ts",
    "pretest": "npm run build:mcp && npm run build:memory-check",
    "prebuild": "npm run build:mcp",
    "preinstall:local": "npm run build:mcp",
    "schema:recipe": "tsx scripts/recipe-schema.ts",
    "build:worker": "esbuild scripts/resource-worker.ts --bundle --platform=node --format=cjs --outfile=assets/resource-worker.cjs",
    "build:memory-check": "esbuild scripts/resource-memory-check.ts --bundle --platform=node --format=cjs --outfile=dist/resource-memory-check.cjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@raycast/api": "2.10.1",
    "acorn": "^8.19.0",
    "jsonc-parser": "3.3.1",
    "react": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.19.0"
}
