{
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "machine": {
      "type": "object",
      "properties": {
        "id": {
          "type": ["string", "null"]
        },
        "source": {
          "enum": ["vscode.env.machineId", "unknown"]
        },
        "scope": {
          "const": "codebuddy-installation"
        },
        "display_name": {
          "type": ["string", "null"]
        },
        "display_name_source": {
          "type": ["string", "null"]
        }
      },
      "required": ["id", "source", "scope"]
    },
    "workspace": {
      "type": "object",
      "properties": {
        "id": {
          "type": ["string", "null"]
        },
        "source": {
          "enum": ["vscode.workspace", "unknown"]
        },
        "scope": {
          "const": "host-at-request"
        },
        "kind": {
          "enum": ["folder", "workspace-file", "untitled", "roots", "empty", "unknown"]
        },
        "name": {
          "type": ["string", "null"]
        },
        "workspace_file": {
          "type": ["string", "null"]
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string"
              },
              "path": {
                "type": ["string", "null"]
              },
              "name": {
                "type": ["string", "null"]
              }
            },
            "required": ["uri", "path", "name"]
          }
        }
      },
      "required": ["id", "source", "scope", "kind", "name", "workspace_file", "roots"]
    },
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": ["string", "null"]
        },
        "kind": {
          "enum": ["session", "subagent"]
        },
        "source": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "session_source": {
          "type": "string"
        },
        "parent_agent_id": {
          "type": ["string", "null"]
        },
        "parent_session_id": {
          "type": ["string", "null"]
        },
        "task_tool_call_id": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "session_id",
        "session_source",
        "parent_agent_id",
        "parent_session_id",
        "task_tool_call_id"
      ]
    },
    "cwd_source": {
      "enum": ["tool-context", "agent-user-context", "unknown"]
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": ["string", "null"]
        },
        "title_source": {
          "type": ["string", "null"]
        },
        "title_observed_at": {
          "type": ["number", "null"],
          "minimum": 0
        }
      },
      "required": ["id", "title", "title_source", "title_observed_at"]
    },
    "observed_at": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["schema", "machine", "workspace", "agent", "cwd_source"],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeBuddy Approval Identity schema 1 (host v5/v6)"
}
